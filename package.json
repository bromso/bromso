{
	"name": "bromso",
	"private": true,
	"description": "Official repository of Jonas Bröms README.md",
	"version": "1.1.0",
	"author": "Jonas Bröms <jonasbroms@icloud.com> (https://jonasbroms.com/)",
	"license": "MIT",
	"homepage": "https://github.com/bromso/bromso#readme",
	"type": "module",
	"engines": {
		"node": ">=22.14"
	},
	"scripts": {
		"lint": "npm run lint:md && npm run lint:links",
		"lint:md": "markdownlint-cli2",
		"lint:links": "node scripts/check-links.mjs",
		"test": "npm run lint:md",
		"release": "semantic-release"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"markdownlint-cli2": "^0.24.0",
		"semantic-release": "^25.0.9"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bromso/bromso.git"
	},
	"bugs": {
		"url": "https://github.com/bromso/bromso/issues"
	},
	"keywords": [
		"semver",
